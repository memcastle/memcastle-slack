#!/usr/bin/env python3
"""Offline Slack replies for native and WASM source conformance. Never contact Slack."""
import json
import os
import sys
from urllib.parse import parse_qs, urlparse

config = sys.stdin.read()
if any(name.startswith('MEMCASTLE_SLACK_') and name.endswith('_TOKEN') for name in os.environ):
    # The selected credential may reach curl through stdin, never its environment.
    sys.exit(21)
try:
    url = next(line.split('"', 2)[1] for line in config.splitlines() if line.startswith('url = "'))
except (IndexError, StopIteration):
    sys.exit(2)
parsed = urlparse(url)
method = parsed.path.rsplit('/', 1)[-1]
params = parse_qs(parsed.query)
channel = params.get('channel', [''])[0]
root = params.get('ts', [''])[0]
auth = next((line for line in config.splitlines() if line.startswith('header = "Authorization: Bearer ')), None)
token = auth.split('Bearer ', 1)[1].split('"', 1)[0] if auth else 'fixture-offline'

first = {'type': 'message', 'ts': '1760000000.000001', 'user': 'U123456789', 'text': 'Plan the release', 'reply_count': 1}
reply = {'type': 'message', 'ts': '1760000001.000001', 'thread_ts': first['ts'], 'user': 'U987654321', 'text': 'Ship on Friday'}
second = {'type': 'message', 'ts': '1760000002.000001', 'user': 'U123456789', 'text': 'Status update'}
if channel == 'D123456789':
    first = {**first, 'text': 'Private check-in'}
    reply = {**reply, 'text': 'Private decision'}
    second = {**second, 'text': 'Private status'}
if token == 'fixture-personal' and channel == 'D123456789':
    first = {**first, 'text': 'Personal check-in'}
    reply = {**reply, 'text': 'Personal decision'}
    second = {**second, 'text': 'Personal status'}
status = 200
if token not in ('fixture-offline', 'fixture-work', 'fixture-other-bot', 'fixture-personal'):
    result = {'ok': False, 'error': 'invalid_auth'}
elif method == 'auth.test':
    result = {'ok': True, 'team_id': 'T987654321' if token == 'fixture-personal' else 'T123456789', 'user_id': 'U000000001'}
elif token == 'fixture-personal' and channel != 'D123456789':
    result = {'ok': False, 'error': 'not_in_channel'}
elif token == 'fixture-work' and channel == 'G123456789':
    result = {'ok': False, 'error': 'not_in_channel'}
elif channel == 'C000000003':
    status = 429
    result = {'ok': False, 'error': 'ratelimited'}
elif channel == 'C000000002':
    result = {'ok': False, 'error': 'missing_scope'}
elif channel == 'C000000001':
    result = {'ok': False, 'error': 'channel_not_found'}
elif channel not in ('C123456789', 'D123456789', 'G123456789', 'C000000004'):
    result = {'ok': False, 'error': 'not_in_channel'}
elif method == 'conversations.info':
    result = {'ok': True, 'channel': {'id': channel, 'name': 'general' if channel[0] == 'C' else channel,
                                      'is_member': True, 'is_channel': channel[0] == 'C',
                                      'is_im': channel[0] == 'D', 'is_mpim': channel[0] == 'G'}}
elif method == 'conversations.history':
    oldest = float(params.get('oldest', ['0'])[0])
    latest = float(params.get('latest', ['9999999999'])[0])
    messages = [m for m in (second, first) if oldest <= float(m['ts']) <= latest]
    result = {'ok': True, 'messages': messages, 'has_more': channel == 'C000000004', 'response_metadata': {'next_cursor': ''}}
elif method == 'conversations.replies':
    messages = [first, reply] if root == first['ts'] else [second] if root == second['ts'] else []
    result = {'ok': True, 'messages': messages, 'has_more': False, 'response_metadata': {'next_cursor': ''}}
else:
    result = {'ok': False, 'error': 'invalid_arguments'}

sys.stdout.write(f'HTTP/1.1 {status} OK\r\nContent-Type: application/json\r\n')
if status == 429:
    sys.stdout.write('Retry-After: 60\r\n')
sys.stdout.write('\r\n')
sys.stdout.write(json.dumps(result, separators=(',', ':')))
sys.stdout.write(f'\nMEMCASTLE_HTTP_STATUS:{status}')
